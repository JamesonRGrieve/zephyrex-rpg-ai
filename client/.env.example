# Copy to `.env` and fill in the blanks. `.env` is gitignored — never commit real secrets.

# Which version this build is: `lite` (self-hosted, one person, no accounts; this app answers
# /api/v1 itself, the default) or `saas` (the same UI; /api/v1 is proxied to the Python server
# in ../server, which has accounts).
RPG_AI_VARIANT=lite
# saas only: where the Python server listens (default http://127.0.0.1:2000).
RPG_AI_SERVER_URI=

# Public origin (sign-in links point here in saas).
APP_URI=http://localhost:1109
# The port `next start` listens on (default 1109).
PORT=
# saas only: more comma-separated routes that require a signed-in person.
PRIVATE_ROUTES=
# Optional: where the server reaches its own API for the session check
# (default http://127.0.0.1:${PORT}/api).
API_UPSTREAM_URL=

# saas only: Square's public ids for checkout (build time).
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=production

# lite only: the SQLite database (Prisma); apply migrations with `pnpm prisma migrate deploy`.
DATABASE_URL=file:./rpg_ai.db

# light or dark, for anyone who has not chosen.
DEFAULT_THEME_MODE=dark
