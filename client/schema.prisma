// The lite edition's records: the same resources, fields and rules as the SaaS server's
// extensions (server/extensions/ai_character, ai_chat). Lite is one person's app with no
// accounts, so every record belongs to the one local owner (@zephyrex/lite localOwner).
// Lists and objects are JSON text the API validates (src/lib/rpgRecords.ts).

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

/// A character card (SillyTavern Character Card V2/V3 fields).
model Character {
  id                      String   @id @default(uuid())
  createdById             String
  name                    String
  description             String   @default("")
  personality             String   @default("")
  scenario                String   @default("")
  firstMessage            String   @default("")
  alternateGreetings      String   @default("[]")
  exampleMessages         String   @default("")
  systemPrompt            String   @default("")
  postHistoryInstructions String   @default("")
  creatorNotes            String   @default("")
  creator                 String   @default("")
  characterVersion        String   @default("")
  tags                    String   @default("[]")
  avatar                  String?
  favourite               Boolean  @default(false)
  /// The gallery folder it sits in (A51); blank: none.
  folder                  String   @default("")
  extensions              String   @default("{}")
  /// The character's own lorebook (a card's embedded character_book), read whenever it speaks.
  lorebookId              String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime
  updatedById             String?

  @@index([createdById])
}

/// Who the person plays as.
model Persona {
  id          String   @id @default(uuid())
  createdById String
  name        String
  description String   @default("")
  avatar      String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  updatedById String?

  @@index([createdById])
}

/// A conversation with one character, or a group of them.
model Chat {
  id           String   @id @default(uuid())
  createdById  String
  title        String
  mode         String   @default("character")
  characterIds String   @default("[]")
  personaId    String?
  presetId     String?
  endpointId   String?
  authorNote   String   @default("")
  lorebookIds  String   @default("[]")
  loreSettings String   @default("{}")
  systemPrompt String   @default("")
  summary      String   @default("")
  tags         String   @default("[]")
  folder       String   @default("")
  mutedIds     String   @default("[]")
  background   String?
  objectives   String   @default("[]")
  contentRating String?
  lines        String   @default("[]")
  veils        String   @default("[]")
  tableNotes   String   @default("[]")
  paused       Boolean  @default(false)
  /// The chat's macro and STscript variables (audit gap 1), as a JSON object of strings.
  variables    String   @default("{}")
  campaignId   String?
  scenarioId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  updatedById  String?

  @@index([createdById])
}

/// One turn of a chat. `parentId` forms the branch tree; `swipes` are a turn's alternatives.
model ChatMessage {
  id                 String   @id @default(uuid())
  createdById        String
  chatId             String
  parentId           String?
  role               String
  channel            String   @default("ic")
  speakerCharacterId String?
  swipes             String   @default("[]")
  swipeIndex         Int      @default(0)
  bookmarked         Boolean  @default(false)
  images             String   @default("[]")
  xCarded            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  updatedById        String?

  @@index([createdById, chatId])
}

/// Sampler settings for a generation.
model GenerationPreset {
  id                String   @id @default(uuid())
  createdById       String
  name              String
  temperature       Float
  topP              Float
  topK              Int
  repetitionPenalty Float
  maxTokens         Int
  contextTokens     Int
  stop              String   @default("[]")
  promptLayout      String   @default("[]")
  logitBias         String   @default("{}")
  negativePrompt    String   @default("")
  guidanceScale     Float?
  /// SillyTavern's further samplers (audit gap 2): only the ones set, as a JSON object (features/prompt/samplers.ts).
  samplers          String   @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  updatedById       String?

  @@index([createdById])
}

/// An OpenAI-compatible endpoint the lite edition generates through (Ollama, llama.cpp, a gateway
/// or a hosted API). The SaaS edition uses the framework's provider instances instead.
model ModelEndpoint {
  id          String   @id @default(uuid())
  createdById String
  name        String
  baseUrl     String
  model       String
  apiKey      String   @default("")
  isDefault   Boolean  @default(false)
  api         String   @default("chat")
  instructTemplate String @default("chatml")
  /// The person's own instruct template (A17), used in place of instructTemplate.
  customTemplateId String?
  /// The size it is asked to draw at (A30), one of the contract's picture sizes; "" is the contract's default.
  imageSize   String   @default("")
  roles       String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  updatedById String?

  @@index([createdById])
}

/// A lorebook (SillyTavern's World Info): entries that enter the prompt when their keys appear.
model Lorebook {
  id          String   @id @default(uuid())
  createdById String
  name        String
  description String   @default("")
  /// The wiki campaign this book is kept in sync with (A15), and when its last sync began.
  wikiCampaignId String?
  wikiSyncedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  updatedById String?

  @@index([createdById])
}

/// One World Info entry: when it activates, what it says, and where it goes.
model LorebookEntry {
  id                  String   @id @default(uuid())
  createdById         String
  lorebookId          String
  /// The wiki entity the entry was made from, set by the wiki sync (A15); null for one written by hand.
  wikiEntityId        String?
  comment             String   @default("")
  keys                String   @default("[]")
  secondaryKeys       String   @default("[]")
  selectiveLogic      String   @default("and_any")
  content             String   @default("")
  enabled             Boolean  @default(true)
  constant            Boolean  @default(false)
  position            String   @default("after_char")
  depth               Int      @default(4)
  role                String   @default("system")
  order               Int      @default(100)
  probability         Int      @default(100)
  inclusionGroup      String   @default("")
  groupWeight         Int      @default(100)
  prioritize          Boolean  @default(false)
  sticky              Int      @default(0)
  cooldown            Int      @default(0)
  delay               Int      @default(0)
  excludeRecursion    Boolean  @default(false)
  preventRecursion    Boolean  @default(false)
  delayUntilRecursion Boolean  @default(false)
  caseSensitive       Boolean?
  matchWholeWords     Boolean?
  characterNames      String   @default("[]")
  characterExclude    Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime
  updatedById         String?

  @@index([createdById, lorebookId])
}

/// A chat's lore timers (sticky and cooldown), written by generation; one per chat.
model ChatLoreState {
  id          String   @id @default(uuid())
  createdById String
  chatId      String   @unique
  state       String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  updatedById String?
}

/// A find-and-replace on chat text (SillyTavern's regex scripts), applied in `position` order.
model RegexScript {
  id          String   @id @default(uuid())
  createdById String
  name        String
  find        String
  replace     String   @default("")
  placements  String   @default("[\"ai_output\"]")
  displayOnly Boolean  @default(false)
  promptOnly  Boolean  @default(false)
  minDepth    Int?
  maxDepth    Int?
  enabled     Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  updatedById String?

  @@index([createdById])
}

/// A button above the composer that sends or fills in a saved line (SillyTavern's Quick Replies).
model QuickReply {
  id          String   @id @default(uuid())
  createdById String
  label       String
  message     String
  action      String   @default("send")
  channel     String   @default("ic")
  enabled     Boolean  @default(true)
  position    Int      @default(0)
  /// When it runs by itself (A38): none, chat_open, after_send or after_reply.
  autoRun     String   @default("none")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  updatedById String?

  @@index([createdById])
}

/// A document for the data bank (SillyTavern's Data Bank): for everyone, one chat or one character.
model DataDocument {
  id          String   @id @default(uuid())
  createdById String
  name        String
  text        String
  scope       String   @default("global")
  scopeId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  updatedById String?

  @@index([createdById])
}

/// A campaign's frame: the table's agreement about what kind of game it is (A57).
model CampaignFrame {
  id             String   @id @default(uuid())
  createdById    String
  name           String
  premise        String   @default("")
  genre          String   @default("")
  dials          String   @default("{}")
  themes         String   @default("[]")
  pillars        String   @default("{}")
  structure      String?
  truths         String   @default("[]")
  characters     String   @default("")
  resolutionMode String?
  /// How the GM runs the game (A20): read by the GM's voices only.
  gmStyle        String   @default("")
  /// The wiki campaign the frame belongs to, when the wiki is loaded.
  wikiCampaignId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  updatedById    String?

  @@index([createdById])
}

/// A scenario: a playable situation as moving parts, with its state in play (A59, A60).
model Scenario {
  id          String   @id @default(uuid())
  createdById String
  name        String
  campaignId  String?
  premise     String   @default("")
  hook        String   @default("")
  stakes      String   @default("")
  situation   String   @default("")
  cast        String   @default("[]")
  places      String   @default("[]")
  clocks      String   @default("[]")
  secrets     String   @default("[]")
  beats       String   @default("[]")
  outcomes    String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  updatedById String?

  @@index([createdById])
}

/// A character's picture for one expression (A4), shown when a line has that feeling.
model CharacterExpression {
  id          String   @id @default(uuid())
  createdById String
  characterId String
  label       String
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  updatedById String?

  @@index([createdById, characterId])
}

/// A person's own instruct template (A17): the markup a text API's model was trained on.
model InstructTemplate {
  id              String   @id @default(uuid())
  createdById     String
  name            String
  start           String   @default("")
  systemPrefix    String   @default("")
  systemSuffix    String   @default("")
  userPrefix      String   @default("")
  userSuffix      String   @default("")
  assistantPrefix String   @default("")
  assistantSuffix String   @default("")
  stop            String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  updatedById     String?

  @@index([createdById])
}

/// A chunk of a chat's older story line, embedded for recall by meaning (A19); written by generation.
/// `digest` is the line's text hashed, so an edited line is embedded again; `model` is the embedding
/// model, and only vectors from the same model are compared.
model ChatMemory {
  id          String   @id @default(uuid())
  createdById String
  chatId      String
  messageId   String
  chunkIndex  Int
  digest      String
  text        String
  model       String
  /// The embedding, as a JSON array.
  vector      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  updatedById String?

  @@unique([chatId, model, messageId, chunkIndex])
  @@index([createdById, chatId])
}
