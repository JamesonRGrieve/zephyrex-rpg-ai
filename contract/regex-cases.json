    {
      "name": "display scripts within their depth bounds",
      "text": "*wave*",
      "scripts": [
        {
          "find": "/\\*(.+?)\\*/g",
          "replace": "<i>$1</i>",
          "placements": [
            "ai_output"
          ],
          "display_only": true,
          "prompt_only": false,
          "min_depth": 1,
          "max_depth": 3,
          "enabled": true
        },
        {
          "find": "/wave/",
          "replace": "WAVE",
          "placements": [
            "ai_output"
          ],
          "display_only": true,
          "prompt_only": false,
          "min_depth": null,
          "max_depth": 0,
          "enabled": true
        }
      ],
      "placement": "ai_output",
      "target": "display",
      "depth": 2,
      "result": "<i>wave</i>"
    },
    {
      "name": "a bare pattern without slashes",
      "text": "cat",
      "scripts": [
        {
          "find": "c(a)t",
          "replace": "d$1g",
          "placements": [
            "ai_output"
          ],
          "display_only": false,
          "prompt_only": false,
          "min_depth": null,
          "max_depth": null,
          "enabled": true
        }
      ],
      "placement": "ai_output",
