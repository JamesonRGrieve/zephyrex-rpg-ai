          ],
          "display_only": false,
          "prompt_only": false,
          "min_depth": null,
          "max_depth": null,
          "enabled": true
        },
        {
          "find": "/b/y",
          "replace": "x",
          "placements": [
            "ai_output"
          ],
          "display_only": false,
          "prompt_only": false,
          "min_depth": null,
          "max_depth": null,
          "enabled": true
        },
        {
          "find": "/c/",
          "replace": "C",
          "placements": [
            "ai_output"
