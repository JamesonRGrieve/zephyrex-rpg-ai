  },
  "memory": {
    "$comment": "Recall by meaning (A19): a chat's older story lines, cut into chunks and embedded by a model set to embed (the embed role) at its OpenAI-compatible POST /embeddings, are recalled by cosine similarity to the last scan_turns and enter the prompt's memories section within section_tokens. Lines in the last recent_turns are never recalled (they are in the context). Cases in contract/memory-cases.json. AP8: a character whose extensions[extension].across_chats is true also recalls from the person's other chats it was cast in, under elsewhere_label ({{char}} its name), within the same budget (contract/memory-across-cases.json).",
    "path": "/embeddings",
    "chunk_characters": 600,
    "recent_turns": 12,
    "scan_turns": 2,
    "recall": 4,
    "min_similarity": 0.2,
    "section_tokens": 400,
    "embed_batch": 64,
    "prefix": "Earlier in the story:\n",
    "extension": "zephyrex_rpg_memory",
    "elsewhere_label": "From other chats with {{char}}:\n"
  },
  "horde": {
    "$comment": "AI Horde (A48): a text job submitted, then polled, never streamed. Its answer reaches the rest of the app as a text completion's stream would.",
    "submit_path": "/v2/generate/text/async",
    "status_path": "/v2/generate/text/status/",
    "poll_ms": 2000,
    "wait_ms": 300000,
    "client_agent": "zephyrex-rpg-ai:0.1:self-hosted",
    "anonymous_key": "0000000000"
  },
  "instruct_custom": {
    "$comment": "A person's own instruct template (A17): the built-ins' fields, each within these limits.",
    "fields": [
      "start",
      "system_prefix",
      "system_suffix",
      "user_prefix",
      "user_suffix",
      "assistant_prefix",
      "assistant_suffix"
    ],
    "field_characters": 200,
    "stops": 8,
    "stop_characters": 64,
    "story_characters": 10000,
    "activation_regex_characters": 200
  },
  "search_apis": ["searxng", "brave"],
  "injections": {
    "$comment": "STscript's /inject (audit gap 5): a chat's named injections, kept until flushed. Each has an id, its text, where it goes (chat: at a depth in the chat, with a role; before or after: at the start or end of the system prompt). features/chat/injections.ts, ai_chat/Injections.py, assemble.ts and Prompt.py.",
    "max": 50,
    "id_characters": 100,
    "text_characters": 10000,
    "positions": ["chat", "before", "after"],
    "roles": ["system", "user", "assistant"],
    "depth_max": 1000,
    "default_depth": 4
  },
  "group_settings": {
    "$comment": "Group chat modes (audit gap 6), a chat's group_settings: card_mode swap (the speaker's card) or join (every member's card, each between the join prefix and suffix); order natural, list or pooled; allow_self (natural order may pick who just spoke); auto_seconds (the next member replies by itself after that long idle, 0 off); scenario (replaces each card's scenario). features/chat/turns.ts, features/prompt/assemble.ts, ai_chat/Prompt.py.",
    "card_modes": ["swap", "join"],
    "orders": ["natural", "list", "pooled"],
    "join_prefix": "<{{char}}>",
    "join_suffix": "</{{char}}>",
    "affix_characters": 200,
    "auto_seconds": [0, 3600],
    "scenario_characters": 10000
  },
  "extra_body": {
    "$comment": "Extra request fields per endpoint (SillyTavern's additional parameters): a JSON object merged into every request body sent to that endpoint, after the app's own fields, so it can set what the app doesn't (reasoning_effort, say) or override a sampler; the fields that carry the conversation are never overridden (features/models/extraBody.ts, ai_chat/ExtraBody.py; cases in contract/extra-body-cases.json).",
    "max_bytes": 4000,
    "max_keys": 30,
    "reserved": ["model", "messages", "prompt", "stream", "system", "systemInstruction", "contents"]
  }
}
