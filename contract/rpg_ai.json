{
  "$comment": "Zephyrex RPG AI's knowledge shared by both back ends and the UI: the self-hosted lite API (client/src/lib), the SaaS server (server/extensions) and the front end read these values from here, never their own copies. Sizes are characters, items or bytes as named. Design: docs/DESIGN.md.",
  "limits": {
    "name_characters": 120,
    "short_text_characters": 300,
    "card_field_characters": 50000,
    "greetings_per_character": 32,
    "tags_per_record": 32,
    "tag_characters": 60,
    "avatar_bytes": 2097152,
    "extensions_bytes": 262144,
    "persona_description_characters": 20000,
    "chat_title_characters": 200,
    "characters_per_chat": 16,
    "author_note_characters": 10000,
    "message_characters": 100000,
    "swipes_per_message": 64,
    "preset_stop_strings": 16,
    "stop_string_characters": 200,
    "endpoint_url_characters": 2048,
    "model_name_characters": 200,
    "api_key_characters": 512,
    "import_bytes": 8388608,
    "lorebook_entries": 2000,
    "lore_keys_per_entry": 64,
    "lore_key_characters": 200,
    "lore_content_characters": 50000,
    "lorebooks_per_chat": 16,
    "chat_system_prompt_characters": 50000,
    "chat_summary_characters": 50000,
    "regex_pattern_characters": 1000,
    "regex_replacement_characters": 50000,
    "regex_scripts": 200,
    "quick_replies": 100,
    "quick_reply_label_characters": 40
  },
  "message_roles": [
    "user",
    "character",
    "narrator",
    "system"
  ],
  "message_channels": [
    "ic",
    "ooc",
    "gm",
    "roll",
    "system"
  ],
  "chat_modes": [
    "character",
    "group"
  ],
  "card_specs": {
    "v2": {
      "spec": "chara_card_v2",
      "spec_version": "2.0"
    },
    "v3": {
      "spec": "chara_card_v3",
      "spec_version": "3.0"
    }
  },
  "sampler_ranges": {
    "temperature": [
      0,
      2
    ],
    "top_p": [
      0,
      1
    ],
    "top_k": [
      0,
      500
    ],
    "repetition_penalty": [
      1,
      2
    ],
    "max_tokens": [
      1,
      8192
    ],
    "context_tokens": [
      512,
      1048576
    ]
  },
  "preset_defaults": {
    "temperature": 0.8,
    "top_p": 0.95,
    "top_k": 40,
    "repetition_penalty": 1.1,
    "max_tokens": 400,
    "context_tokens": 8192
  },
  "prompt": {
    "default_system_prompt": "Write {{char}}'s next reply in a fictional chat between {{char}} and {{user}}. Stay in character, and write only {{char}}'s part.",
    "author_note_depth": 4,
    "characters_per_token": 4,
    "message_overhead_tokens": 4,
    "story_channels": [
      "ic",
      "roll"
    ],
    "impersonate_prompt": "Write {{user}}'s next reply in this chat, in {{user}}'s own voice. Write only {{user}}'s part.",
    "modes": [
      "reply",
      "continue",
      "impersonate"
    ],
    "sections": [
      "main",
      "lore_before_char",
      "description",
      "personality",
      "scenario",
      "lore_after_char",
      "persona",
      "lore_before_example",
      "examples",
      "lore_after_example",
      "summary",
      "author_note",
      "post_history"
    ],
    "section_token_range": [
      1,
      32768
    ],
    "summary_prefix": "Summary of the story so far:\n",
    "summarize_prompt": "Summarize the story so far in a few short paragraphs: who is in it, where they are, what has happened and what is still unresolved. Write only the summary."
  },
  "lore": {
    "$comment": "World Info (SillyTavern's lorebooks): how entries activate and where they go. client/src/features/lore/activate.ts and server/extensions/ai_chat/Lore.py implement it; contract/lore-cases.json holds the cases both run.",
    "positions": [
      "before_char",
      "after_char",
      "before_example",
      "after_example",
      "before_an",
      "after_an",
      "at_depth"
    ],
    "selective_logic": [
      "and_any",
      "not_all",
      "not_any",
      "and_all"
    ],
    "depth_roles": [
      "system",
      "user",
      "assistant"
    ],
    "defaults": {
      "scan_depth": 4,
      "token_budget": 1024,
      "recursion_steps": 3,
      "depth": 4,
      "order": 100,
      "probability": 100,
      "group_weight": 100
    },
    "ranges": {
      "scan_depth": [
        0,
        1000
      ],
      "token_budget": [
        0,
        1048576
      ],
      "recursion_steps": [
        0,
        10
      ],
      "depth": [
        0,
        1000
      ],
      "order": [
        -100000,
        100000
      ],
      "probability": [
        0,
        100
      ],
      "group_weight": [
        1,
        10000
      ],
      "timed": [
        0,
        1000
      ]
    }
  },
  "paid_features": {},
  "endpoint_apis": [
    "chat",
    "text"
  ],
  "instruct_templates": {
    "chatml": {
      "name": "ChatML",
      "start": "",
      "system_prefix": "<|im_start|>system\n",
      "system_suffix": "<|im_end|>\n",
      "user_prefix": "<|im_start|>user\n",
      "user_suffix": "<|im_end|>\n",
      "assistant_prefix": "<|im_start|>assistant\n",
      "assistant_suffix": "<|im_end|>\n",
      "stop": [
        "<|im_end|>"
      ]
    },
    "llama3": {
      "name": "Llama 3",
      "start": "<|begin_of_text|>",
      "system_prefix": "<|start_header_id|>system<|end_header_id|>\n\n",
      "system_suffix": "<|eot_id|>",
      "user_prefix": "<|start_header_id|>user<|end_header_id|>\n\n",
      "user_suffix": "<|eot_id|>",
      "assistant_prefix": "<|start_header_id|>assistant<|end_header_id|>\n\n",
      "assistant_suffix": "<|eot_id|>",
      "stop": [
        "<|eot_id|>"
      ]
    },
    "alpaca": {
      "name": "Alpaca",
      "start": "",
      "system_prefix": "",
      "system_suffix": "\n\n",
      "user_prefix": "### Instruction:\n",
      "user_suffix": "\n\n",
      "assistant_prefix": "### Response:\n",
      "assistant_suffix": "\n\n",
      "stop": [
        "### Instruction:"
      ]
    },
    "mistral": {
      "name": "Mistral",
      "start": "<s>",
      "system_prefix": "[INST] ",
      "system_suffix": " [/INST]",
      "user_prefix": "[INST] ",
      "user_suffix": " [/INST]",
      "assistant_prefix": "",
      "assistant_suffix": "</s>",
      "stop": [
        "</s>",
        "[INST]"
      ]
    }
  },
  "regex": {
    "placements": [
      "user_input",
      "ai_output"
    ],
    "targets": [
      "stored",
      "display",
      "prompt"
    ],
    "flags": "gims",
    "depth_range": [
      0,
      10000
    ]
  },
  "reasoning": {
    "pairs": [
      [
        "<think>",
        "</think>"
      ],
      [
        "<thinking>",
        "</thinking>"
      ],
      [
        "<reasoning>",
        "</reasoning>"
      ]
    ]
  },
  "quick_reply": {
    "actions": [
      "send",
      "fill"
    ],
    "channels": [
      "ic",
      "ooc"
    ]
  }
}
