  "prompt": {
    "default_system_prompt": "Write {{char}}'s next reply in a fictional chat between {{char}} and {{user}}. Stay in character, and write only {{char}}'s part.",
    "author_note_depth": 4,
    "characters_per_token": 4,
    "message_overhead_tokens": 4,
    "story_channels": ["ic", "roll"],
    "impersonate_prompt": "Write {{user}}'s next reply in this chat, in {{user}}'s own voice. Write only {{user}}'s part.",
    "continue_nudge": "[Continue your last message without repeating its original content.]",
    "own_prompts": 20,
    "own_prompt_depth": 1000,
    "modes": ["reply", "continue", "impersonate", "table", "narrate"],
    "sections": [
      "main",
      "safety",
      "table_notes",
      "campaign",
      "running_scenario",
      "lore_before_char",
      "description",
      "personality",
      "scenario",
      "lore_after_char",
      "persona",
      "lore_before_example",
      "examples",
      "lore_after_example",
      "data_bank",
      "memories",
      "summary",
      "author_note",
      "post_history"
    ],
    "section_token_range": [1, 32768],
    "summary_prefix": "Summary of the story so far:\n",
    "summarize_prompt": "Summarize the story so far in a few short paragraphs: who is in it, where they are, what has happened and what is still unresolved. Write only the summary.",
    "translate_prompt": "Translate the user's text into {{language}}. Keep its meaning, tone, names and any *action* markup. Write only the translation.",
    "objective_prompt": "{{char}}'s current task: {{task}} Work toward it naturally, without stating it.",
    "objective_depth": 2,
    "narrate_prompt": "You are the game master, narrating this story. Describe what happens next: the world, the people in it and what comes of what the characters did, in a few vivid paragraphs. Never speak, act or decide for {{user}}.",
    "cast_heading": "The characters:",
    "narrator_name": "Narrator"
  },
  "lore": {
    "$comment": "World Info (SillyTavern's lorebooks): how entries activate and where they go. client/src/features/lore/activate.ts and server/extensions/ai_chat/Lore.py implement it; contract/lore-cases.json holds the cases both run.",
    "positions": [
      "before_char",
      "after_char",
      "before_example",
      "after_example",
      "before_an",
      "after_an",
      "at_depth"
    ],
    "selective_logic": ["and_any", "not_all", "not_any", "and_all"],
    "depth_roles": ["system", "user", "assistant"],
    "defaults": {
      "scan_depth": 4,
      "token_budget": 1024,
      "recursion_steps": 3,
      "depth": 4,
      "order": 100,
      "probability": 100,
      "group_weight": 100
    },
    "ranges": {
      "scan_depth": [0, 1000],
      "token_budget": [0, 1048576],
      "recursion_steps": [0, 10],
      "depth": [0, 1000],
      "order": [-100000, 100000],
      "probability": [0, 100],
      "group_weight": [1, 10000],
      "timed": [0, 1000]
    }
  },
  "paid_features": {},
  "endpoint_apis": ["chat", "text", "horde", "anthropic", "google"],
  "persona": {
    "$comment": "Personas (audit gap 9): where the description goes (the persona section, a depth in the chat, the top or bottom of the author's note, or nowhere), the role it has at a depth, and the characters it's locked to (features/prompt/personaPick.ts, ai_chat/PersonaPick.py).",
    "positions": ["prompt", "depth", "note_top", "note_bottom", "none"],
    "roles": ["system", "user", "assistant"],
    "depth_max": 1000,
    "default_depth": 2,
    "title_characters": 120,
    "locked_characters": 100
  },
  "native_apis": {
    "$comment": "Native APIs (audit gap 8): Anthropic's Messages API and Google's Gemini API, asked from the same chat messages as an OpenAI-compatible endpoint and read back as its stream (features/models/nativeApis.ts, ai_chat/NativeApis.py; cases in contract/native-api-cases.json). A conversation must open on the person's turn: when it doesn't, `opening` is that turn.",
    "anthropic_version": "2023-06-01",
    "anthropic_temperature_max": 1,
    "opening": "(The story begins.)"
  },
  "instruct_templates": {
    "chatml": {
      "name": "ChatML",
      "start": "",
      "system_prefix": "<|im_start|>system\n",
      "system_suffix": "<|im_end|>\n",
      "user_prefix": "<|im_start|>user\n",
      "user_suffix": "<|im_end|>\n",
      "assistant_prefix": "<|im_start|>assistant\n",
      "assistant_suffix": "<|im_end|>\n",
      "stop": ["<|im_end|>"]
    },
    "llama3": {
      "name": "Llama 3",
      "start": "<|begin_of_text|>",
      "system_prefix": "<|start_header_id|>system<|end_header_id|>\n\n",
      "system_suffix": "<|eot_id|>",
      "user_prefix": "<|start_header_id|>user<|end_header_id|>\n\n",
      "user_suffix": "<|eot_id|>",
      "assistant_prefix": "<|start_header_id|>assistant<|end_header_id|>\n\n",
      "assistant_suffix": "<|eot_id|>",
      "stop": ["<|eot_id|>"]
    },
    "alpaca": {
      "name": "Alpaca",
      "start": "",
      "system_prefix": "",
      "system_suffix": "\n\n",
      "user_prefix": "### Instruction:\n",
      "user_suffix": "\n\n",
      "assistant_prefix": "### Response:\n",
      "assistant_suffix": "\n\n",
      "stop": ["### Instruction:"]
    },
    "mistral": {
      "name": "Mistral",
      "start": "<s>",
      "system_prefix": "[INST] ",
      "system_suffix": " [/INST]",
      "user_prefix": "[INST] ",
      "user_suffix": " [/INST]",
      "assistant_prefix": "",
      "assistant_suffix": "</s>",
      "stop": ["</s>", "[INST]"]
    }
  },
  "regex": {
    "placements": ["user_input", "ai_output"],
    "targets": ["stored", "display", "prompt"],
    "flags": "gims",
    "depth_range": [0, 10000]
