        { "role": "system", "content": "[Bram is hungry.]" },
        { "role": "user", "content": "Ada: Two" },
        { "role": "assistant", "content": "Three" },
        { "role": "user", "content": "Narrator: Four" },
        { "role": "user", "content": "Sam: Five" },
        { "role": "system", "content": "Keep Bram's reply under 60 words." }
