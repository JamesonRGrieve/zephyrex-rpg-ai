        "history": [
          { "role": "user", "channel": "ic", "speaker_character_id": null, "content": "One" },
          { "role": "character", "channel": "ic", "speaker_character_id": "c-ada", "content": "Two" },
          { "role": "character", "channel": "ic", "speaker_character_id": "c-bram", "content": "Three" },
          { "role": "narrator", "channel": "ic", "speaker_character_id": null, "content": "Four" },
          { "role": "user", "channel": "ic", "speaker_character_id": null, "content": "Five" }
        ],
        "context_tokens": 8192,
        "max_tokens": 400
      },
      "messages": [
        { "role": "system", "content": "You are Bram.\n\nBram is the ship's cook." },
