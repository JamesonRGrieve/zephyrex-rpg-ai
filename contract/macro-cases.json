    {
      "name": "random from a list, either syntax, and a die",
      "text": "{{random::a::b::c}} {{random:x,y}} {{roll:d6}}",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        },
        "random": [
          0.5,
          0.0,
          0.99
        ]
      },
      "text_out": "b x 6",
      "local_out": null,
      "global_out": null
    },
    {
      "name": "dice with a count and a bonus or penalty",
      "text": "{{roll:2d6+1}} {{roll::3d4-1}}",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        },
        "random": [
          0.0,
          0.5,
          0.25,
          0.25,
          0.25
        ]
      },
      "text_out": "6 5",
      "local_out": null,
      "global_out": null
    },
    {
      "name": "no random source, so random and roll stay",
      "text": "{{random::a::b}} {{roll:d6}}",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        }
      },
      "text_out": "{{random::a::b}} {{roll:d6}}",
      "local_out": null,
      "global_out": null
    },
    {
      "name": "pick is stable per chat, text and place",
      "text": "{{pick::a::b::c}} {{pick::a::b::c}}",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        },
        "chat": {
          "chat_id": "chat-1"
        }
      },
      "text_out": "a c",
      "local_out": null,
      "global_out": null
    },
    {
      "name": "variables set, added, counted and read",
      "text": "{{setvar::mood::grim}}{{getvar::mood}} {{addvar::hp::5}}{{getvar::hp}} {{incvar::hp}} {{decvar::count}} {{.mood}} {{setglobalvar::seen::1}}{{$seen}}",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        },
        "local": {
          "hp": "10"
        }
      },
      "text_out": "grim 15 16 -1 grim 1",
      "local_out": {
        "hp": "16",
        "mood": "grim",
        "count": "-1"
      },
      "global_out": {
        "seen": "1"
      }
    },
    {
      "name": "addvar joins text that isn't a number",
      "text": "{{addvar::log::a}}{{addvar::log::b}}{{getvar::log}}",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        }
      },
      "text_out": "ab",
      "local_out": {
        "log": "ab"
      },
      "global_out": {}
    },
    {
      "name": "the older single-colon and space spellings",
      "text": "{{getvar:hp}} {{getvar hp}}",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        },
        "local": {
          "hp": "3"
        }
      },
      "text_out": "3 3",
      "local_out": null,
      "global_out": null
    },
    {
      "name": "newline, noop, comments, trim, reverse and outlets",
      "text": "a{{newline}}b{{noop}}{{// a note}}c\n\n{{trim}}\n\nd {{reverse::abc}}{{outlet::x}}",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        }
      },
      "text_out": "a\nbcd cba",
      "local_out": null,
      "global_out": null
    },
    {
      "name": "nested macros, the innermost first",
      "text": "{{reverse::{{char}}}} {{random::{{char}}::{{user}}}}",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        },
        "random": [
          0.9
        ]
      },
      "text_out": "adA Sam",
      "local_out": null,
      "global_out": null
    },
    {
      "name": "names are case-insensitive",
      "text": "{{CHAR}} {{Random::a}}",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        },
        "random": [
          0.2
        ]
      },
      "text_out": "Ada a",
      "local_out": null,
      "global_out": null
