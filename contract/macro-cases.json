    {
      "name": "the time in the person's zone, another zone and a format",
      "text": "{{time}}|{{date}}|{{weekday}}|{{isotime}}|{{isodate}}|{{time_UTC+2}}|{{datetimeformat::YYYY-MM-DD HH:mm:ss [at] ddd}}",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        },
        "now": {
          "epoch_ms": 1795269909000,
          "utc_offset_minutes": -420
