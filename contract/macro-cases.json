{
  "$comment": "SillyTavern's macros (audit gap 1): cases both twins run (client/src/features/prompt/macros.test.ts, server/extensions/ai_chat/Macros_test.py). A context's `random` is the sequence of draws in [0, 1), used in order; `now` is epoch milliseconds and the person's offset from UTC in minutes. Pick's index is FNV-1a (32-bit, UTF-8) of chat id, NUL, the whole text, NUL, the macro as written, NUL, its occurrence, modulo the items.",
  "cases": [
    {
      "name": "the names in every spelling",
      "text": "{{char}} greets {{ USER }}. <BOT> waves at <USER>.",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        }
      },
      "text_out": "Ada greets Sam. Ada waves at Sam.",
      "local_out": null,
      "global_out": null
    },
    {
      "name": "an unknown macro stays as written, its inner macros filled",
      "text": "{{wobble::x}} {char} {{wobble::{{char}}}}",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        }
      },
      "text_out": "{{wobble::x}} {char} {{wobble::Ada}}",
      "local_out": null,
      "global_out": null
    },
    {
      "name": "the card's and persona's fields",
      "text": "{{description}}|{{personality}}|{{scenario}}|{{persona}}|{{mesExamples}}|{{charPrompt}}|{{charJailbreak}}|{{model}}",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        },
        "fields": {
          "description": "A pilot.",
          "personality": "Dry.",
          "scenario": "A ship.",
          "persona": "A cook.",
          "mesExamples": "<START>",
          "charPrompt": "Be Ada.",
          "charInstruction": "Stay short.",
          "model": "tiny"
        }
      },
      "text_out": "A pilot.|Dry.|A ship.|A cook.|<START>|Be Ada.|Stay short.|tiny",
      "local_out": null,
      "global_out": null
    },
    {
      "name": "a field not given is empty",
      "text": "[{{scenario}}]",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        }
      },
      "text_out": "[]",
      "local_out": null,
      "global_out": null
    },
    {
      "name": "group names in a group",
      "text": "{{group}}/{{charIfNotGroup}}/{{notChar}}",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        },
        "group": "Ada, Bo",
        "not_char": "Bo, Sam"
      },
      "text_out": "Ada, Bo/Ada, Bo/Bo, Sam",
      "local_out": null,
      "global_out": null
    },
    {
      "name": "group names outside a group",
      "text": "{{group}}/{{charIfNotGroup}}/{{notChar}}",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        }
      },
      "text_out": "Ada/Ada/Sam",
      "local_out": null,
      "global_out": null
    },
    {
      "name": "the chat's last lines and the input",
      "text": "{{lastMessage}}|{{lastUserMessage}}|{{lastCharMessage}}|{{lastMessageId}}|{{input}}",
      "context": {
        "names": {
          "char": "Ada",
          "user": "Sam"
        },
        "chat": {
          "last_message": "Aye.",
          "last_user_message": "Ready?",
          "last_char_message": "Aye.",
          "last_message_id": "m-9",
          "input": "Go"
        }
      },
      "text_out": "Aye.|Ready?|Aye.|m-9|Go",
      "local_out": null,
      "global_out": null
    },
