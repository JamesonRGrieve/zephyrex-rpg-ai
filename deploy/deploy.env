# Build-time settings for the client prod-zephyrex-rpg runs. Next fixes these at build: the
# public origin is inlined into the bundle (and, as NEXT_PUBLIC_APP_URI, decides that the CSP
# upgrades requests to https), and the /api/v1 rewrite to the server is compiled into the
# standalone server's routes.
RPG_AI_VARIANT=saas
APP_URI=https://rpg.zephyrex.ca
RPG_AI_SERVER_URI=http://127.0.0.1:2000
DEFAULT_THEME_MODE=dark
# Sign in with Zephyrex's Authentik (server: OIDC_CONSUMER_* and FRAMEWORK_FERNET_KEY in its env;
# the redirect URI <APP_URI>/user/close/authentik is registered on the Authentik provider).
NEXT_PUBLIC_OAUTH_PROVIDERS=authentik
NEXT_PUBLIC_OAUTH_LABEL=Zephyrex
