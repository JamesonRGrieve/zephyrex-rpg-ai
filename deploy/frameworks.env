# The framework commits a Zephyrex RPG AI build uses, each from its public GitHub repository.
# Zephyrex RPG AI's path dependencies expect the checkouts beside the repository
# (server/pyproject.toml and client/pnpm-workspace.yaml reach them at ../../<name>).
# Bump a ref, and a deploy builds against it. A ref must be on GitHub before a deploy can
# fetch it.
SERVER_FRAMEWORK_REF=f0f99e5526a532e2d0a9e3e98b0b2edc11f1b18c
CLIENT_FRAMEWORK_REF=40e0dbfd6afe6fd2ac579edd44116486b66d8f27
AUTH_REF=94bf3960e1796469ce99752902e88fa30479a33d
DYNAMIC_FORM_REF=95ad4daa4fc93105e754601323d2cd5a601a8061
ZOD2GQL_REF=2309c5984e7ace7a5ce9414cab5b158bcc881625
# The suite (docs/SUITE.md, Together; the operator, 2026-11-21): rpg-ai runs with the wiki's and the
# VTT's server extensions, from their pinned checkouts beside this repository.
WIKI_REF=4936b54e07bc655076d186b8d69333615674c5dd
VTT_REF=f4815db60704a93f7573de794b78a6bac79d3f11
